# =========================================================
# DEVELOPMENT ENVIRONMENT  (Docker Compose — local machine)
# =========================================================
# NEVER commit real secrets here. This file is for local dev only.
# Variable names must match production exactly — only values differ.

# ── Repo 1 (Identity / Ingestion API) ──────────────────────
# Dev: Docker service name on the shared afric network
# Prod: Docker service name on the production stack
REPO1_URL=http://afric-analyzer-api-local:8080
REPO1_BASE_URL=http://afric-analyzer-api-local:8080

# ── Redis ───────────────────────────────────────────────────
# Dev: Redis container on Repo 1's afric-shared network
# Prod: Dedicated Redis container
REDIS_URL=redis://afric-analyzer-redis-local:6379/0

# ── Database ─────────────────────────────────────────────────
# Dev: Postgres container (db) on siem-dev-network
# Prod: postgres container on siem-internal network
DATABASE_URL=postgresql://siem_user:siem_password@db:5432/siem_db
POSTGRES_USER=siem_user
POSTGRES_PASSWORD=siem_password
POSTGRES_DB=siem_db

# ── Security ─────────────────────────────────────────────────
# MUST match Repo 1's SECRET_KEY exactly (copy from Repo 1 .env.development)
SECRET_KEY=Fv2pkCopnlN9WkwjSjHWowOxjJfXSwdeOyDh_NLVaMNMcmL4uJTwPSwyz3XmMJZi
# Shared service-to-service key (must match Repo 1's ADMIN_KEY)
ADMIN_KEY=4BltQka5aJ_EHKPvdf0zP_7eEyR7aETtSxW5X-ZMqJMVszhcaWqgFcmPoPkLDGf7

# ── Dashboard / API ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,analyzer
LOG_LEVEL=DEBUG
EXPOSE_DOCS=true
DEV_MODE=true
