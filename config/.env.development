REPO1_URL= http://afric-analyzer-api-local:8080

# 3. Database
# Local sandbox database
DATABASE_URL=sqlite:///./dev_siem_analyzer.db
POSTGRES_USER=siem_user
POSTGRES_PASSWORD=siem_password
