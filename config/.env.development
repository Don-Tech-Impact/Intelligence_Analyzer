# ========================================
# DEVELOPMENT ENVIRONMENT
# ========================================
# Use this file exclusively for local testing. Rename or link to .env

# 1. Identity Service (Repo 1)
# Points to local Afric Analyzer running on the Docker network
REPO1_URL=http://afric-analyzer-api-local:8080

# 2. Redis Configuration 
# Usually running locally alongside Repo 1
REDIS_URL=redis://redis-local:6379/0

# 3. Database
# Local sandbox database
DATABASE_URL=sqlite:///./dev_siem_analyzer.db

# 4. Security (Match Repo 1 dev secret)
# Use the same DEV secret being used by Afric Analyzer 
SECRET_KEY="super-secret-dev-key"

# 5. Dashboard Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# 6. API Tuning
LOG_LEVEL=DEBUG
EXPOSE_DOCS=true
